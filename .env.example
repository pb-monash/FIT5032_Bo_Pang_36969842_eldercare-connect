# Firebase external authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STAFF_EMAILS=staff@eldercare.org

# Serverless API used for email, exports, and cloud-only actions
# Leave blank for Firebase Hosting production deployment; the app will call
# the same-origin /api/email/queue rewrite. Set this only for local emulators
# or another hosted function base URL.
VITE_CLOUD_FUNCTIONS_BASE_URL=

# Cloudflare Worker example secrets, configured on the cloud platform only
# ALLOWED_ORIGINS=https://your-deployment.example
# REQUIRE_FUNCTION_TOKEN=false
# EMAIL_FUNCTION_TOKEN=

# Email provider configuration is set on the serverless platform only.
# Do not expose SendGrid, Brevo, or SMTP secrets in Vite client env files.

# Map provider key for service search and route planning
VITE_MAP_PROVIDER=maptiler
VITE_MAP_API_KEY=

# Firebase Functions secrets, set with:
# firebase functions:secrets:set BREVO_API_KEY
# firebase functions:secrets:set BREVO_SENDER_EMAIL
# firebase functions:secrets:set BREVO_SENDER_NAME
# or the SENDGRID_* equivalents.
