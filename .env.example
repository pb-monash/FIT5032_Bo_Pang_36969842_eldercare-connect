# Firebase external authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STAFF_EMAILS=staff@eldercare.org

# Serverless API used for email, exports, and cloud-only actions
# For the free A3 deployment, set this to the Cloudflare Worker URL, for example:
# https://eldercare-connect-email.<your-workers-subdomain>.workers.dev
VITE_CLOUD_FUNCTIONS_BASE_URL=

# Cloudflare Worker / Brevo secrets, configured on Cloudflare only
# ALLOWED_ORIGINS=https://your-deployment.example
# REQUIRE_FUNCTION_TOKEN=false
# EMAIL_FUNCTION_TOKEN=
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=ElderCare Connect

# Email provider configuration is set on the serverless platform only.
# Do not expose SendGrid, Brevo, or SMTP secrets in Vite client env files.

# Map provider key for service search and route planning
VITE_MAP_PROVIDER=maptiler
VITE_MAP_API_KEY=

# Firebase Functions are optional and require Firebase Blaze, so the free A3
# deployment uses Cloudflare Workers for the serverless email endpoint.
